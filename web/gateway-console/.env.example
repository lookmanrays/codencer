# Gateway Console defaults to live/product mode.
# Use demo only for deterministic local screenshots or UI review.
NEXT_PUBLIC_CODENCER_CONSOLE_MODE=live

# Server-side Next proxy target. Browser code calls /api/gateway/v1/*.
CODENCER_GATEWAY_API_BASE=http://127.0.0.1:19090

# Preferred console token. The proxy also accepts CODENCER_GATEWAY_MCP_TOKEN
# or CODENCER_GATEWAY_TOKEN as fallback env names.
CODENCER_GATEWAY_CONSOLE_TOKEN=<gateway-console-token>
